  data = darfur, treat = "directlyharmed",
  benchmark_covariates = "female",
  cluster = "village", reps = 100, seed = 1, progress = FALSE
)
out

# Benchmark strength on the partial-R2 and partial-correlation scales
out$benchmark_strength

}
